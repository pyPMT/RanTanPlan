    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pmt-build/planmt-up-cli",
            "args": [
                "-p", "${workspaceFolder}/test/precompiled-problems/dinner-p1.pb",
                "-o", "${workspaceFolder}/sandbox",
                "-s", "topk(k=3,timeout=300,memorylimit=2048)",
                "-e", "sequential(detect_symmetries=false)"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb"
        }

    ]
}